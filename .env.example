# Supabase project URL — used by both the frontend build and the Netlify Function.
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase ANON key — injected into index.html at build time (build.sh).
# This is the public key shown under Supabase → Settings → API → Project API keys → anon public.
# It is safe to use client-side because Row Level Security (RLS) restricts it to read + insert only.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase SERVICE ROLE key — used only by the Netlify Function (server-side, never sent to the browser).
# Found under Supabase → Settings → API → Project API keys → service_role.
# Keep this secret — it bypasses RLS.
SUPABASE_KEY=your-supabase-service-role-key
